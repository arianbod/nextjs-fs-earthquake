# QuakeWise Internal API - Environment Variables Configuration
# 🔒 For QuakeWise Team Only
# Copy this file to .env.local and fill in your values from team password manager

# ====================
# INTERNAL SERVICE TOKENS
# ====================
# Pre-registered service tokens (get from team password manager)
# Generate new tokens with: npm run generate:service-tokens

# Web Application Service (WEB_APP tier: 10k/hr)
SERVICE_TOKEN_WEB_APP=your_web_app_service_token_here

# Mobile API Service (WEB_APP tier: 10k/hr)
SERVICE_TOKEN_MOBILE=your_mobile_service_token_here

# Batch Processing Service (BATCH_JOB tier: 1k/hr)
SERVICE_TOKEN_BATCH=your_batch_service_token_here

# Analytics Service (BATCH_JOB tier: 1k/hr)
SERVICE_TOKEN_ANALYTICS=your_analytics_service_token_here

# Development & Testing Service (DEV_TESTING tier: 500/hr)
SERVICE_TOKEN_DEV=your_dev_testing_service_token_here

# ====================
# JWT AUTHENTICATION
# ====================
# JWT secret for signing user tokens (get from team password manager)
JWT_SECRET=your_256_bit_jwt_secret_here

# JWT Token expiry duration (examples: 7d, 24h, 60m, 3600s)
JWT_EXPIRY=7d

# JWT Issuer identifier
JWT_ISSUER=quakewise-internal-api

# ====================
# DATABASE (Neon PostgreSQL)
# ====================
# Neon PostgreSQL connection strings (get from team password manager)
# Dashboard: https://console.neon.tech

# Pooled connection (for application queries)
# Used by: Prisma, API queries
DATABASE_URL=postgresql://username:password@endpoint-name.region.aws.neon.tech/database_name?sslmode=require&pgbouncer=true

# Direct connection (required for Prisma migrations - local dev only)
# In Vercel, POSTGRES_URL_NON_POOLING is auto-populated by Neon integration
DIRECT_URL=postgresql://username:password@endpoint-name.region.aws.neon.tech/database_name?sslmode=require

# Note: Vercel will have both DATABASE_URL and POSTGRES_URL_NON_POOLING
# prisma.config.ts uses DATABASE_URL + POSTGRES_URL_NON_POOLING

# ====================
# EXISTING QUAKEWISE SERVICES
# ====================
# These should already be configured in your existing .env.local

# Anthropic Claude AI API Key (required for AI image analysis)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Maps API Key (required for geospatial services)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Clerk Authentication (for main app and API docs access)
CLERK_SECRET_KEY=your_clerk_secret_key_here
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# OpenWeather API Key (optional for weather data)
NEXT_PUBLIC_OPENWEATHER_API_KEY=your_openweather_api_key_here

# ====================
# APPLICATION SETTINGS
# ====================
# Node environment
NODE_ENV=development

# API URL (for documentation and testing)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# ====================
# TEAM SETUP INSTRUCTIONS
# ====================
# 1. Copy this file: cp .env.local.example .env.local
#
# 2. Get credentials from team password manager (1Password/Vault):
#    - Look for "QuakeWise API Tokens" vault
#    - Copy all SERVICE_TOKEN_* values
#    - Copy JWT_SECRET
#    - Copy DATABASE_URL and DIRECT_URL (Neon PostgreSQL)
#
# 3. If setting up for first time (DevOps/Admin only):
#    - Generate service tokens: npm run generate:service-tokens
#    - Store tokens in team password manager
#    - Add to Vercel environment variables for production
#
# 4. Initialize database:
#    - Push schema: npm run db:push
#    - Seed services: npm run db:seed
#    - (Optional) Open Prisma Studio: npm run db:studio
#
# 5. Verify setup:
#    - Start dev server: npm run dev
#    - Access API docs: http://localhost:3000/api-docs (requires Clerk login with @quakewise.com email)
#    - Run API tests: npm run api:test
#
# ====================
# SECURITY NOTES
# ====================
# - NEVER commit .env.local to version control
# - ALL tokens must be stored in team password manager
# - Use different tokens for development and production
# - Rotate tokens if compromised (regenerate and reseed database)
# - Keep service tokens secure - they provide full API access
# - Only team members with @quakewise.com email can access API docs
# - Report any security concerns to #security Slack channel
#
# ====================
# SERVICE TIERS & RATE LIMITS
# ====================
# Defined in config/internal-services.js:
# - WEB_APP: 10,000 req/hr, 100,000 req/day
# - BATCH_JOB: 1,000 req/hr, 50,000 req/day
# - DEV_TESTING: 500 req/hr, 5,000 req/day
#
# Pre-registered services:
# - quakewise-web-app (WEB_APP)
# - quakewise-mobile-api (WEB_APP)
# - batch-assessment-processor (BATCH_JOB)
# - analytics-service (BATCH_JOB)
# - dev-testing-service (DEV_TESTING)
#
