# QuakeWise External API - Environment Variables Configuration
# Copy this file to .env.local and fill in your values

# ====================
# PLATFORM AUTHENTICATION
# ====================
# Generate a secure 256-bit token for platform authentication
# You can generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_PLATFORM_SECRET=your_256_bit_platform_secret_token_here

# ====================
# JWT AUTHENTICATION
# ====================
# Generate a secure 256-bit secret for JWT signing
# You can generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_256_bit_jwt_secret_here

# JWT Token expiry duration (examples: 7d, 24h, 60m, 3600s)
JWT_EXPIRY=7d

# JWT Issuer identifier
JWT_ISSUER=quakewise-api

# ====================
# DATABASE
# ====================
# Path to SQLite database file (optional, defaults to ./data/api_usage.db)
API_DATABASE_PATH=./data/api_usage.db

# ====================
# RATE LIMITING
# ====================
# Rate limits per tier (requests per hour)
RATE_LIMIT_FREE_TIER=100
RATE_LIMIT_PRO_TIER=1000
RATE_LIMIT_ENTERPRISE_TIER=10000

# ====================
# EXISTING QUAKEWISE SERVICES
# ====================
# These should already be configured in your existing .env.local

# Anthropic Claude AI API Key (required for AI image analysis)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Maps API Key (required for geospatial services)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Clerk Authentication (for main app)
CLERK_SECRET_KEY=your_clerk_secret_key_here
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# OpenWeather API Key (optional for weather data)
NEXT_PUBLIC_OPENWEATHER_API_KEY=your_openweather_api_key_here

# ====================
# APPLICATION SETTINGS
# ====================
# Node environment
NODE_ENV=development

# API URL (for documentation and testing)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# ====================
# SETUP INSTRUCTIONS
# ====================
# 1. Copy this file: cp .env.local.example .env.local
# 2. Generate secure tokens:
#    - API_PLATFORM_SECRET
#    - JWT_SECRET
# 3. Add your existing API keys:
#    - ANTHROPIC_API_KEY
#    - NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
#    - CLERK_SECRET_KEY
#    - NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
# 4. Restart your development server: npm run dev

# ====================
# SECURITY NOTES
# ====================
# - NEVER commit .env.local to version control
# - Use different tokens for development and production
# - Rotate tokens periodically
# - Keep your platform tokens secure and do not share them
# - Use environment variables in production deployment (Vercel, AWS, etc.)
