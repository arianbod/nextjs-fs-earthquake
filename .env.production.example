# QuakeWise API - Production Environment Variables
# Add these to Vercel Dashboard → Settings → Environment Variables

# ===========================
# DOMAIN CONFIGURATION
# ===========================
NEXT_PUBLIC_APP_URL=https://quakewise.com
NEXT_PUBLIC_API_URL=https://quakewise.com/api/v1

# ===========================
# API AUTHENTICATION
# ===========================
# Generate with: npm run api:prod-tokens
API_PLATFORM_SECRET=<your-256-bit-platform-secret>
JWT_SECRET=<your-256-bit-jwt-secret>
JWT_EXPIRY=7d
JWT_ISSUER=quakewise-api

# Admin secret for app registration endpoint
ADMIN_SECRET=<your-256-bit-admin-secret>

# ===========================
# DATABASE (Neon PostgreSQL)
# ===========================
# Neon PostgreSQL connection string with connection pooling
# Get from Neon Dashboard: https://console.neon.tech
DATABASE_URL=<your-neon-pooled-connection-string>

# Neon Direct connection (required for migrations)
DIRECT_URL=<your-neon-direct-connection-string>

# ===========================
# LOGGING
# ===========================
LOG_DIR=/tmp/logs
NODE_ENV=production

# ===========================
# EXISTING QUAKEWISE SERVICES
# ===========================
# AI Service
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# Geospatial Services
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<your-google-maps-api-key>

# Authentication (Clerk)
CLERK_SECRET_KEY=<your-clerk-secret-key>
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<your-clerk-publishable-key>

# Weather Service (Optional)
NEXT_PUBLIC_OPENWEATHER_API_KEY=<your-openweather-api-key>

# ===========================
# RATE LIMITING (Optional)
# ===========================
RATE_LIMIT_FREE_TIER=100
RATE_LIMIT_PRO_TIER=1000
RATE_LIMIT_ENTERPRISE_TIER=10000

# ===========================
# SECURITY NOTES
# ===========================
# 1. Never commit these values to git
# 2. Use different tokens for dev and production
# 3. Rotate secrets every 90 days
# 4. Store tokens in secure password manager
# 5. Monitor for unauthorized access
