# QuakeWise Internal API - Production Environment Variables
# 🔒 For DevOps/Admin Team Only
# Add these to Vercel Dashboard → Settings → Environment Variables

# ===========================
# DOMAIN CONFIGURATION
# ===========================
NEXT_PUBLIC_APP_URL=https://quakewise.com
NEXT_PUBLIC_API_URL=https://quakewise.com/api/v1

# ===========================
# INTERNAL SERVICE TOKENS
# ===========================
# Get from team password manager (1Password/Vault)
# Generate with: npm run generate:service-tokens

# Web Application Service (WEB_APP tier: 10k/hr)
SERVICE_TOKEN_WEB_APP=<your-web-app-service-token>

# Mobile API Service (WEB_APP tier: 10k/hr)
SERVICE_TOKEN_MOBILE=<your-mobile-service-token>

# Batch Processing Service (BATCH_JOB tier: 1k/hr)
SERVICE_TOKEN_BATCH=<your-batch-service-token>

# Analytics Service (BATCH_JOB tier: 1k/hr)
SERVICE_TOKEN_ANALYTICS=<your-analytics-service-token>

# Development & Testing Service (DEV_TESTING tier: 500/hr)
SERVICE_TOKEN_DEV=<your-dev-testing-service-token>

# ===========================
# JWT AUTHENTICATION
# ===========================
# Get from team password manager
JWT_SECRET=<your-256-bit-jwt-secret>
JWT_EXPIRY=7d
JWT_ISSUER=quakewise-internal-api

# ===========================
# DATABASE (Neon PostgreSQL)
# ===========================
# Neon PostgreSQL connection strings
# Get from Neon Dashboard: https://console.neon.tech

# Pooled connection (for application queries)
DATABASE_URL=<your-neon-pooled-connection-string>

# Direct connection (required for migrations)
DIRECT_URL=<your-neon-direct-connection-string>

# ===========================
# LOGGING
# ===========================
LOG_DIR=/tmp/logs
NODE_ENV=production

# ===========================
# EXISTING QUAKEWISE SERVICES
# ===========================
# Get from team password manager

# AI Service (Anthropic Claude)
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# Geospatial Services (Google Maps)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<your-google-maps-api-key>

# Authentication (Clerk)
CLERK_SECRET_KEY=<your-clerk-secret-key>
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<your-clerk-publishable-key>

# Weather Service (Optional)
NEXT_PUBLIC_OPENWEATHER_API_KEY=<your-openweather-api-key>

# ===========================
# VERCEL DEPLOYMENT INSTRUCTIONS
# ===========================
# 1. Copy all SERVICE_TOKEN_* values from team password manager
# 2. Add to Vercel:
#    - Go to Settings → Environment Variables
#    - Add each variable for Production, Preview, and Development environments
#    - Click "Save"
# 3. After deployment, run database seed:
#    - Vercel CLI: vercel env pull .env.production
#    - Run: npm run db:seed
# 4. Verify API:
#    - Access https://quakewise.com/api-docs (requires Clerk @quakewise.com email)
#    - Run test: npm run api:test
#
# ===========================
# SECURITY NOTES
# ===========================
# 1. Never commit these values to git
# 2. ALL tokens stored in team password manager (1Password/Vault)
# 3. Use different tokens for dev and production
# 4. Rotate service tokens if compromised
# 5. Monitor API usage in Prisma Studio or usage endpoints
# 6. Only team members with @quakewise.com email can access API docs
# 7. Report security incidents to #security Slack channel
#
# ===========================
# SERVICE TIERS & RATE LIMITS
# ===========================
# Defined in config/internal-services.js:
# - WEB_APP: 10,000 req/hr, 100,000 req/day
# - BATCH_JOB: 1,000 req/hr, 50,000 req/day
# - DEV_TESTING: 500 req/hr, 5,000 req/day
#
# Pre-registered services (defined in config/internal-services.js):
# - quakewise-web-app (WEB_APP)
# - quakewise-mobile-api (WEB_APP)
# - batch-assessment-processor (BATCH_JOB)
# - analytics-service (BATCH_JOB)
# - dev-testing-service (DEV_TESTING)
#
