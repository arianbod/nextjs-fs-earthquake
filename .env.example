# OpenAI API Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Clerk Authentication (https://clerk.com)
# Get these from https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3005
NEXT_PUBLIC_API_BASE_URL=http://localhost:3005

# Google Maps API (https://console.cloud.google.com/)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Turkey Seismic Data API (Optional)
NEXT_PUBLIC_SEISMIC_API_ENDPOINT=https://api.example.com/seismic
NEXT_PUBLIC_SEISMIC_API_KEY=your-seismic-api-key

# SendGrid Email Service (https://sendgrid.com)
SENDGRID_API_KEY=SG.your-sendgrid-api-key
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Earthquake Safety App

# Application Settings
DEFAULT_LANGUAGE=en
WEBSITE_USER=babagpt.ai

# Environment
NODE_ENV=development
